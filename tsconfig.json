{
  "compilerOptions": {
    /* File Layout */
    "rootDir": "./src",
    "outDir": "./dist"
    ,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },
    /* Environment Settings */
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node"],

    /* NestJS decorators */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    /* Output */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Type Checking */
    "strict": false,
    "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,

    /* Performance */
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
